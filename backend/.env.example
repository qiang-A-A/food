# =============================================================================
# .env.example — 后端环境变量示例（复制为 .env 后按需修改）
# -----------------------------------------------------------------------------
# 功能：集中管理后端运行所需的配置项，避免敏感信息（密钥/密码）硬编码进代码。
# 说明：config.py 通过 pydantic-settings 自动读取本文件；生产环境由部署侧注入。
# =============================================================================

# ---- 应用基础 ----
APP_NAME=天上宫阙官网后端服务
ENV=development                    # development / production
DEBUG=true

# ---- 安全 ----
# JWT 签名密钥：生产环境必须替换为足够长的随机字符串（可用 `python -c "import secrets;print(secrets.token_hex(32))"` 生成）
SECRET_KEY=change-me-to-a-random-64-hex-string
# 访问令牌有效期（分钟）：MVP 保持默认 1440（24 小时）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 数据库 ----
# 开发环境：SQLite（零部署成本）；生产环境：PostgreSQL 连接串
# 生产示例：postgresql+psycopg://user:pass@host:5432/tsgq
DATABASE_URL=sqlite:///./tsgq_dev.db

# ---- 文件上传 ----
UPLOAD_DIR=./uploads
MAX_IMAGE_MB=10                    # 图片上限（jpg/png/webp）
MAX_VIDEO_MB=100                   # 视频上限（mp4，仅超管可上传）

# ---- 初始超级管理员（seed 脚本读取，首次部署后强制修改）----
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=admin123456
