# =============================================================================
# deploy/.env.production.example — 生产环境变量模板
# -----------------------------------------------------------------------------
# 用法：复制为服务器上 backend 目录的 .env，逐项替换为真实值。
# 安全：SECRET_KEY 必须用足够长的随机串生成（见下方命令）。
# =============================================================================

# ---- 应用 ----
APP_NAME=天上宫阙官网后端服务
ENV=production
DEBUG=false

# ---- 安全（必改！）----
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-replace-with-64-hex-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 数据库（生产用 PostgreSQL，必改）----
# 格式：postgresql+psycopg://user:password@host:5432/tsgq
DATABASE_URL=postgresql+psycopg://tsgq_user:CHANGE_ME@127.0.0.1:5432/tsgq

# ---- 上传目录（与 Nginx /uploads/ 别名保持一致）----
UPLOAD_DIR=/app/uploads
MAX_IMAGE_MB=10
MAX_VIDEO_MB=100

# ---- 初始超管（首次部署 seed 使用，上线后立即修改密码）----
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CHANGE_ME_STRONG
